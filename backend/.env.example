JACK_ENV=development
JACK_HOST=127.0.0.1
JACK_PORT=8000
JACK_LOG_LEVEL=INFO
JACK_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional development fallback. Prefer entering the key in AI Hub to store it in macOS Keychain.
# NVIDIA_API_KEY=
# Optional database path override. The default is a stable per-user data folder.
# JACK_MEMORY_DB_PATH=/absolute/path/to/memories.sqlite3

